                "portId": "p-clean-out",
                "actionId": "a-clean",
                "outputName": "clean",
                "schema": "s-clean",
                "drop_nulls": [],
                "fill_nulls": {},
                "replacements": {},
                "drop_duplicates": false,
                "constraints": {},
                "iqr_outliers": null,
                "fuzzy_detect": null,
                "operations": [
                  { "op": "trim", "columns": ["Name","City"] },
                  { "op": "if", "columns": ["Department"], "expr": "if(lower(trim(Department))='sales','SALES','OTHER')" },
                  { "op": "ifs", "columns": ["City"], "expr": "ifs(starts_with(lower(trim(City)),'san'),'San*', lower(trim(City))='boston','BOS','Other')" },
                  { "op": "value", "columns": ["MonthlyIncome"], "target_type": "DOUBLE" },
                  { "op": "text", "columns": ["MonthlyIncome"], "fmt": "%.2f" }
                ]
              }
            ]
          }
        ],
