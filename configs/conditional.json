                "portId": "p-derive-out",
                "actionId": "a-derive",
                "outputName": "derived",
                "schema": "s-derived",
                "derivedFields": [
                  { "newFieldName": "Band", "userExpression": "if(MonthlyIncome >= 68000, 'High', 'Standard')" },
                  { "newFieldName": "RegionTag", "userExpression": "ifs(starts_with(lower(trim(City)),'san'),'San Region', lower(trim(City))='boston','Boston Region','Other')" }
                ]
              }
            ]
          },
          {
            "elementType": "action",
            "actionType": "clean",
            "title": "Clean: in-place IF/IFS (case-insensitive)",
            "id": "a-clean",
            "version": 1,
