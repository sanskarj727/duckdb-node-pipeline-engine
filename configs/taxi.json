          ]
        },
        "s-derived": {
          "id": "s-derived",
          "version": 1,
          "elementType": "data-table",
          "name": "derived",
          "fields": [
            { "id": "tpep_pickup_datetime", "name": "tpep_pickup_datetime", "elementType": "data-field", "datatype": "date", "usage": { "type": "time" }, "index": 0 },
            { "id": "PULocationID", "name": "PULocationID", "elementType": "data-field", "datatype": "integer", "usage": { "type": "category" }, "index": 1 },
            { "id": "trip_distance", "name": "trip_distance", "elementType": "data-field", "datatype": "number", "usage": { "type": "measure" }, "index": 2 },
            { "id": "fare_amount", "name": "fare_amount", "elementType": "data-field", "datatype": "number", "usage": { "type": "measure" }, "index": 3 },
            { "id": "tip_amount", "name": "tip_amount", "elementType": "data-field", "datatype": "number", "usage": { "type": "measure" }, "index": 4 },
