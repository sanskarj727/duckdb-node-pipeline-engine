            { "id": "avg_extras", "elementType": "data-field", "name": "avg_extras", "datatype": "number", "usage": { "type": "measure" }, "index": 5 }
          ]
        },
        "s-summary-b": {
          "id": "s-summary-b",
          "version": 1,
          "elementType": "data-table",
          "name": "summary_b",
          "fields": [
            { "id": "PULocationID", "elementType": "data-field", "name": "PULocationID", "datatype": "integer", "usage": { "type": "category" }, "index": 0 },
            { "id": "avg_distance_only", "elementType": "data-field", "name": "avg_distance_only", "datatype": "number", "usage": { "type": "measure" }, "index": 1 }
          ]
        },
        "s-joined": {
          "id": "s-joined",
          "version": 1,
          "elementType": "data-table",
          "name": "joined_summary",
          "fields": [
            { "id": "PULocationID", "elementType": "data-field", "name": "PULocationID", "datatype": "integer", "usage": { "type": "category" }, "index": 0 },
            { "id": "num_trips", "elementType": "data-field", "name": "num_trips", "datatype": "integer", "usage": { "type": "measure" }, "index": 1 },
            { "id": "avg_distance", "elementType": "data-field", "name": "avg_distance", "datatype": "number", "usage": { "type": "measure" }, "index": 2 },
            { "id": "avg_fare", "elementType": "data-field", "name": "avg_fare", "datatype": "number", "usage": { "type": "measure" }, "index": 3 },
            { "id": "avg_tip_rate", "elementType": "data-field", "name": "avg_tip_rate", "datatype": "number", "usage": { "type": "measure" }, "index": 4 },
            { "id": "avg_extras", "elementType": "data-field", "name": "avg_extras", "datatype": "number", "usage": { "type": "measure" }, "index": 5 },
            { "id": "avg_distance_only", "elementType": "data-field", "name": "avg_distance_only", "datatype": "number", "usage": { "type": "measure" }, "index": 6 }
          ]
        }
      },
      "flowModel": {
        "actions": [
          {
            "elementType": "action",
            "actionType": "derive-fields",
            "title": "Derive A",
            "id": "a-derive",
            "version": 2,
            "inputs": [
              { "id": "p-derive-in", "version": 1, "itemType": "port", "elementType": "port", "portType": "input", "schema": "s-raw", "index": 0, "parent": "a-derive", "name": "yellow parquet" }
            ],
            "outputs": [
              { "id": "p-derive-out", "name": "derived", "elementType": "port", "portType": "output", "schema": "s-derived" }
            ],
            "config": [
              {
                "type": "derive-fields",
                "portId": "p-derive-out",
                "actionId": "a-derive",
                "outputName": "derived",
                "schema": "s-derived",
                "derivedFields": [
                  {
                    "newFieldId": "trip_duration_minutes",
                    "newFieldName": "trip_duration_minutes",
                    "newFieldDataType": "number",
                    "newFieldUsageType": "measure",
                    "aqExpression": "datediff('minute', d['tpep_pickup_datetime'], d['tpep_dropoff_datetime'])",
                    "userExpression": "datediff('minute', tpep_pickup_datetime, tpep_dropoff_datetime)"
                  },
                  {
                    "newFieldId": "tip_rate",
                    "newFieldName": "tip_rate",
                    "newFieldDataType": "number",
                    "newFieldUsageType": "measure",
                    "aqExpression": "case when d['fare_amount'] > 0 then (d['tip_amount'] / d['fare_amount']) * 100 else 0 end",
                    "userExpression": "case when fare_amount > 0 then (tip_amount / fare_amount) * 100 else 0 end"
                  },
                  {
                    "newFieldId": "total_extras",
                    "newFieldName": "total_extras",
                    "newFieldDataType": "number",
                    "newFieldUsageType": "measure",
                    "aqExpression": "d['total_amount'] - d['fare_amount'] - d['tip_amount']",
                    "userExpression": "total_amount - fare_amount - tip_amount"
                  }
                ]
              }
            ]
          },
          {
            "elementType": "action",
            "actionType": "summarize",
            "title": "Summarize A",
            "id": "a-summarize",
            "version": 2,
            "inputs": [
              { "id": "p-sum-in", "version": 1, "itemType": "port", "elementType": "port", "portType": "input", "schema": "s-derived", "index": 0, "parent": "a-summarize", "name": "derived" }
            ],
            "outputs": [
              { "id": "p-sum-out", "name": "summary_a", "elementType": "port", "portType": "output", "schema": "s-summary-a" }
            ],
            "config": [
              {
                "type": "summarize",
                "portId": "p-sum-out",
                "actionId": "a-summarize",
                "outputName": "summary_a",
                "schema": "s-summary-a",
                "groupFields": ["PULocationID"],
                "summaryFields": [
                  { "aggFunction": "count", "sourceFieldId": "*", "newFieldName": "num_trips", "newFieldId": "num_trips" },
                  { "aggFunction": "avg", "sourceFieldId": "trip_distance", "newFieldName": "avg_distance", "newFieldId": "avg_distance" },
                  { "aggFunction": "avg", "sourceFieldId": "fare_amount", "newFieldName": "avg_fare", "newFieldId": "avg_fare" },
                  { "aggFunction": "avg", "sourceFieldId": "tip_rate", "newFieldName": "avg_tip_rate", "newFieldId": "avg_tip_rate" },
                  { "aggFunction": "avg", "sourceFieldId": "total_extras", "newFieldName": "avg_extras", "newFieldId": "avg_extras" }
                ]
              }
            ]
          },
          {
            "elementType": "action",
            "actionType": "summarize",
            "title": "Summarize B (distance only)",
            "id": "b-summarize",
            "version": 2,
            "inputs": [
              { "id": "p-bsum-in", "version": 1, "itemType": "port", "elementType": "port", "portType": "input", "schema": "s-derived", "index": 0, "parent": "b-summarize", "name": "derived" }
            ],
            "outputs": [
              { "id": "p-bsum-out", "name": "summary_b", "elementType": "port", "portType": "output", "schema": "s-summary-b" }
            ],
            "config": [
              {
                "type": "summarize",
                "portId": "p-bsum-out",
                "actionId": "b-summarize",
                "outputName": "summary_b",
                "schema": "s-summary-b",
                "groupFields": ["PULocationID"],
                "summaryFields": [
                  { "aggFunction": "avg", "sourceFieldId": "trip_distance", "newFieldName": "avg_distance_only", "newFieldId": "avg_distance_only" }
                ]
              }
            ]
          },
          {
            "elementType": "action",
            "actionType": "join",
            "title": "Join Summaries",
            "id": "j-join",
            "version": 2,
            "inputs": [
              { "id": "p-join-left", "version": 1, "itemType": "port", "elementType": "port", "portType": "input", "schema": "s-summary-a", "index": 0, "parent": "j-join", "name": "summary_a" },
              { "id": "p-join-right", "version": 1, "itemType": "port", "elementType": "port", "portType": "input", "schema": "s-summary-b", "index": 1, "parent": "j-join", "name": "summary_b" }
            ],
            "outputs": [
              { "id": "p-join-out", "name": "joined_out", "elementType": "port", "portType": "output", "schema": "s-joined" }
            ],
            "config": [
              {
                "type": "join",
                "portId": "p-join-out",
                "actionId": "j-join",
                "outputName": "joined_out",
                "schema": "s-joined",
                "join_type": "inner",
                "left_on": ["PULocationID"],
                "right_on": ["PULocationID"],
                "suffixes": ["_a", "_b"]
              }
            ]
          },
          {
            "elementType": "action",
            "actionType": "sort",
            "title": "Sort Joined",
            "id": "a-sort",
            "version": 2,
            "inputs": [
              { "id": "p-sort-in", "version": 1, "itemType": "port", "elementType": "port", "portType": "input", "schema": "s-joined", "index": 0, "parent": "a-sort", "name": "joined_out" }
            ],
            "outputs": [
              { "id": "p-sort-out", "name": "joined_sorted", "elementType": "port", "portType": "output", "schema": "s-joined" }
            ],
            "config": [
              {
                "type": "sort",
                "portId": "p-sort-out",
                "actionId": "a-sort",
                "outputName": "joined_sorted",
                "schema": "s-joined",
                "sortFields": [
                  { "fieldId": "num_trips", "isDesc": true }
                ]
              }
            ]
          }
        ],
        "connections": [
          { "id": "c1", "version": 1, "elementType": "connection", "name": "", "target": { "action": "a-derive", "input": "p-derive-in" }, "source": { "action": "src-1", "output": "p-src-out" } },
          { "id": "c2", "version": 1, "elementType": "connection", "name": "", "target": { "action": "a-summarize", "input": "p-sum-in" }, "source": { "action": "a-derive", "output": "p-derive-out" } },
          { "id": "c3", "version": 1, "elementType": "connection", "name": "", "target": { "action": "b-summarize", "input": "p-bsum-in" }, "source": { "action": "a-derive", "output": "p-derive-out" } },
          { "id": "c4", "version": 1, "elementType": "connection", "name": "", "target": { "action": "j-join", "input": "p-join-left" }, "source": { "action": "a-summarize", "output": "p-sum-out" } },
          { "id": "c5", "version": 1, "elementType": "connection", "name": "", "target": { "action": "j-join", "input": "p-join-right" }, "source": { "action": "b-summarize", "output": "p-bsum-out" } },
          { "id": "c6", "version": 1, "elementType": "connection", "name": "", "target": { "action": "a-sort", "input": "p-sort-in" }, "source": { "action": "j-join", "output": "p-join-out" } }
        ]
