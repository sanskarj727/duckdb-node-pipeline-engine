            { "id": "trip_distance", "elementType": "data-field", "name": "trip_distance", "datatype": "number", "usage": { "type": "measure" }, "index": 3 },
            { "id": "fare_amount", "elementType": "data-field", "name": "fare_amount", "datatype": "number", "usage": { "type": "measure" }, "index": 4 },
