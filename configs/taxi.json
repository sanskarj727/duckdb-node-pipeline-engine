            { "id": "total_extras", "name": "total_extras", "elementType": "data-field", "datatype": "number", "usage": { "type": "measure" }, "index": 8 }
          ],
          "baseSchemaId": "s-raw"
        },
        "s-summary-a": {
          "id": "s-summary-a",
          "version": 1,
          "elementType": "data-table",
          "name": "summary_a",
          "fields": [
            { "id": "PULocationID", "elementType": "data-field", "name": "PULocationID", "datatype": "integer", "usage": { "type": "category" }, "index": 0 },
            { "id": "num_trips", "elementType": "data-field", "name": "num_trips", "datatype": "integer", "usage": { "type": "measure" }, "index": 1 },
            { "id": "avg_distance", "elementType": "data-field", "name": "avg_distance", "datatype": "number", "usage": { "type": "measure" }, "index": 2 },
            { "id": "avg_fare", "elementType": "data-field", "name": "avg_fare", "datatype": "number", "usage": { "type": "measure" }, "index": 3 },
