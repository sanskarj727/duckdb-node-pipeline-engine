            { "type": "source", "portId": "p-src-out", "actionId": "src-1", "schema": "s-raw", "name": "fuzzytest", "outputName": "fuzzytest" }
          ],
          "inputs": [],
          "outputs": [
            { "id": "p-src-out", "name": "fuzzytest", "elementType": "port", "portType": "output", "schema": "s-raw" }
          ],
          "portType": "input"
        }
      ],
      "schemaDictionary": {
        "s-raw": {
          "id": "s-raw",
          "version": 1,
          "elementType": "data-table",
          "name": "raw",
          "fields": [
            { "id": "rowid", "elementType": "data-field", "name": "rowid", "datatype": "integer", "index": 0 },
            { "id": "player_of_match", "elementType": "data-field", "name": "player_of_match", "datatype": "string", "index": 1 }
          ]
        },
        "s-fuzzy": {
          "id": "s-fuzzy",
          "version": 1,
          "elementType": "data-table",
          "name": "fuzzy",
          "fields": [
            { "id": "rowid", "elementType": "data-field", "name": "rowid", "datatype": "integer", "index": 0 },
            { "id": "player_of_match", "elementType": "data-field", "name": "player_of_match", "datatype": "string", "index": 1 },
            { "id": "fuzzy_similarity", "elementType": "data-field", "name": "fuzzy_similarity", "datatype": "number", "index": 2 },
            { "id": "most_similar", "elementType": "data-field", "name": "most_similar", "datatype": "string", "index": 3 }
          ]
        }
      },
      "flowModel": {
        "actions": [
          {
            "elementType": "action",
            "actionType": "fuzzy-detect",
            "title": "Fuzzy Detect Players",
            "id": "a-fuzzy",
            "version": 1,
            "inputs": [
