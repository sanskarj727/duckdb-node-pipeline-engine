            ],
            "config": {
              "column": "player_of_match",
              "output_col": "fuzzy_similarity",
              "label_col": "most_similar",
              "threshold": 0.5
            }
          }
        ],
        "connections": [
          { "id": "c1", "version": 1, "elementType": "connection", "name": "", "target": { "action": "a-fuzzy", "input": "p-fuzzy-in" }, "source": { "action": "src-1", "output": "p-src-out" } }
